# 统一换行，二进制文件不做任何转换
* text=auto eol=lf

*.bin    binary
*.bit    binary
*.elf    binary
*.onnx   binary
*.param  binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.docx   binary
*.zip    binary

*.md     text eol=lf
*.txt    text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.tcl    text eol=lf
*.ps1    text eol=crlf

